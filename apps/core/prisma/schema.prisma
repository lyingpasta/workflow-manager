// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Workflow {
  id        String    @id
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  isActive  Boolean   @default(false) @map("is_active")

  workflowSchemas WorkflowSchema[]
  executions      WorkflowExecution[]

  @@map("workflow")
}

model WorkflowSchema {
  id        String    @id
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  schema    Json
  isActive  Boolean   @map("is_active")

  workflowId String   @map("workflow_id")
  workflow   Workflow @relation(fields: [workflowId], references: [id])

  executions WorkflowExecution[]

  @@map("workflow_schema")
}

model WorkflowExecution {
  id        String    @id
  status    String    @default("started")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  workflow         Workflow        @relation(fields: [workflowId], references: [id])
  workflowId       String          @map("workflow_id")
  workflowSchema   WorkflowSchema  @relation(map: "workflow_id", references: [id], fields: [workflowSchemaId])
  workflowSchemaId String          @map("workflow_schema_id")
  nodeExections    NodeExecution[]

  @@map("workflow_execution")
}

model NodeExecution {
  id         String    @id
  nodeId     String    @map("node_id")
  nextNodeId String?   @map("next_node_id")
  status     String    @default("pending")
  input      Json?
  output     Json?
  isStart    Boolean   @map("is_start")
  isEnd      Boolean   @map("is_end")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  workflowExecutionId String
  workflowExecution   WorkflowExecution @relation(fields: [workflowExecutionId], references: [id])

  @@map("node_execution")
}
